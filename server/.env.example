# ───────────────────────────────────────
# BarScan Server — Environment Variables
# Copy this file to .env and fill in your values
# ───────────────────────────────────────

# Express server port
PORT=3001

# MySQL connection
DB_HOST=your-cloud-host.example.com
DB_PORT=3306
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=barscan

# Optional: set to true to use SSL for cloud MySQL
DB_SSL=false
